<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>edu.example</groupId>
        <artifactId>web-services-task2</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>soap-client</artifactId>
    <properties>
        <student.endpoint>http://localhost:8080/students</student.endpoint>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.sun.xml.ws</groupId>
            <artifactId>jaxws-rt</artifactId>
            <version>${metro.version}</version>
        </dependency>
        <dependency>
            <groupId>edu.example</groupId>
            <artifactId>soap-service</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>com.sun.xml.ws</groupId>
                <artifactId>jaxws-maven-plugin</artifactId>
                <version>${metro.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>wsimport</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <wsdlDirectory>${project.basedir}/../soap-service/target/wsdl</wsdlDirectory>
                    <wsdlFiles>
                        <wsdlFile>StudentService.wsdl</wsdlFile>
                    </wsdlFiles>
                    <packageName>edu.example.client.generated</packageName>
                    <wsdlLocation>http://localhost:8080/students?wsdl</wsdlLocation>
                    <keep>true</keep>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <executable>${java.home}/bin/java</executable>
                    <arguments>
                        <argument>-classpath</argument>
                        <classpath/>
                        <argument>edu.example.client.StudentClient</argument>
                        <argument>${student.endpoint}</argument>
                    </arguments>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>live-wsdl</id>
            <properties>
                <student.wsdl>http://localhost:8080/students?wsdl</student.wsdl>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.sun.xml.ws</groupId>
                        <artifactId>jaxws-maven-plugin</artifactId>
                        <configuration combine.self="override">
                            <wsdlUrls>
                                <wsdlUrl>${student.wsdl}</wsdlUrl>
                            </wsdlUrls>
                            <packageName>edu.example.client.generated</packageName>
                            <wsdlLocation>${student.wsdl}</wsdlLocation>
                            <keep>true</keep>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
