<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>edu.example</groupId>
        <artifactId>web-services-task2</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>soap-service</artifactId>
    <properties>
        <student.endpoint>http://localhost:8080/students</student.endpoint>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.sun.xml.ws</groupId>
            <artifactId>jaxws-rt</artifactId>
            <version>${metro.version}</version>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>com.sun.xml.ws</groupId>
                <artifactId>jaxws-maven-plugin</artifactId>
                <version>${metro.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>wsgen</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <sei>edu.example.service.StudentServiceImpl</sei>
                    <genWsdl>true</genWsdl>
                    <resourceDestDir>${project.build.directory}/wsdl</resourceDestDir>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <executable>${java.home}/bin/java</executable>
                    <arguments>
                        <argument>-classpath</argument>
                        <classpath/>
                        <argument>edu.example.service.ServicePublisher</argument>
                        <argument>${student.endpoint}</argument>
                    </arguments>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
